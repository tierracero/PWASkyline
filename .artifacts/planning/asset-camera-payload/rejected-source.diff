+        private func remoteCameraImage(for eventId: UUID) -> ImageGeneralView? {
+            guard isInDOM, remoteCameraSessionId == custCatchID,
+                  !finishedRemoteCameraEvents.contains(eventId) else { return nil }
+
+            if let view = imageRefrence[eventId] {
+                return view
+            }
+
+            let view = ImageGeneralView(
+                relation: .assetItem,
+                relationId: nil,
+                type: .img,
+                mediaId: nil,
+                file: nil,
+                image: nil,
+                descr: "",
+                width: 0,
+                height: 0,
+                selectedAvatar: $selectedAvatar,
+                callback: { [weak self] viewId, _, _, originalImage, originalWidth, originalHeight, _ in
+                    guard let view = self?.uploadFileControler[viewId] else { return }
+                    view.file = originalImage
+                    view.width = originalWidth
+                    view.height = originalHeight
+                },
+                imAvatar: { [weak self] _, name in
+                    self?.selectedAvatar = name
+                },
+                removeMe: { [weak self] _ in
+                    self?.discardRemoteCameraImage(for: eventId)
+                }
+            )
+
+            // Remote events use the capture ID; submission and card callbacks use the view ID.
+            imageRefrence[eventId] = view
+            uploadFileControler[view.viewId] = view
+            imageOrder.append(view.viewId)
+            view.loadPercent = "Iniciando Carga..."
+            mediaGrid.appendChild(view)
+            return view
+        }
+
+        private func discardRemoteCameraImage(for eventId: UUID) {
+            finishedRemoteCameraEvents.insert(eventId)
+            guard let view = imageRefrence.removeValue(forKey: eventId) else { return }
+            uploadFileControler.removeValue(forKey: view.viewId)
+            imageOrder.removeAll { $0 == view.viewId }
+            if view.image == selectedAvatar {
+                selectedAvatar = ""
+            }
+        }
+
+        private func removeRemoteCameraImage(for eventId: UUID) {
+            guard remoteCameraSessionId == custCatchID,
+                  !finishedRemoteCameraEvents.contains(eventId) else { return }
+            let view = imageRefrence[eventId]
+            discardRemoteCameraImage(for: eventId)
+            view?.remove()
         }
 
